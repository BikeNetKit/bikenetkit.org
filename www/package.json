{
	"name": "bikenetkit-www",
	"private": true,
	"version": "1.0.0",
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"engines": {
		"node": ">=20.12"
	},
	"packageManager": "pnpm@11.23.0",
	"scripts": {
		"dev": "node scripts/check-fonts.mjs && LAUNCH_EDITOR=code vite dev",
		"build": "node scripts/check-fonts.mjs && vite build",
		"preview": "vite preview",
		"prepare": "playwright install chromium && svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:hulls": "node --experimental-strip-types --no-warnings scripts/check-hulls.mjs",
		"check:coverage": "node --experimental-strip-types --no-warnings scripts/check-coverage.mjs",
		"check:datasets": "node --experimental-strip-types --no-warnings scripts/check-datasets.mjs",
		"check:build-output": "node scripts/check-build-output.mjs",
		"check:privacy": "node scripts/check-privacy.mjs",
		"check:headers": "node scripts/check-headers.mjs",
		"check:links": "node --experimental-strip-types --no-warnings scripts/check-links.mjs",
		"check:og-cards": "node scripts/check-og-cards.mjs",
		"check:search": "node --experimental-strip-types --no-warnings scripts/check-search.mjs",
		"check:map-tables": "node --experimental-strip-types --no-warnings scripts/check-map-tables.mjs",
		"check:a11y": "playwright test --config=playwright.a11y.config.js",
		"lint": "node scripts/check-fonts.mjs && prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:e2e": "playwright test",
		"test": "pnpm run test:e2e",
		"generate:screenshots": "playwright test --config=playwright.screenshots.config.js",
		"generate:og": "playwright test --config=playwright.screenshots.config.js generate-og",
		"generate:og-cards": "node scripts/generate-og-cards.mjs",
		"generate:gif": "node scripts/generate-gif.mjs",
		"generate:video": "node scripts/generate-video.mjs",
		"generate:videos": "node scripts/generate-video.mjs --all",
		"generate:tutorial-thumbs": "node scripts/fetch-tutorial-thumbnails.mjs",
		"update-data": "node scripts/update-data.mjs",
		"import:context": "node scripts/import-context-points.mjs",
		"import:contacts": "node scripts/import-contact-links.mjs",
		"build:geo": "node scripts/build-land-geo.mjs",
		"build:glyphs": "node scripts/build-map-glyphs.mjs",
		"build:mapstyle": "node scripts/build-map-style.mjs",
		"pull-data": "node scripts/pull-data.mjs",
		"pull-screenshots": "node scripts/pull-screenshots.mjs",
		"basemap:build": "node scripts/build-basemap.mjs",
		"deploy:site": "node scripts/deploy.mjs",
		"deploy:placeholder": "node scripts/deploy.mjs --placeholder",
		"deploy:preview": "node scripts/deploy.mjs --preview",
		"deploy:basemap": "node scripts/deploy-basemap.mjs",
		"deploy:mapstyle": "node scripts/build-map-style.mjs && node scripts/deploy-map-style.mjs",
		"deploy:media": "node scripts/deploy-media.mjs",
		"deploy:data": "node scripts/deploy-data.mjs",
		"compress:data": "node scripts/compress-data.mjs",
		"fonts:check": "node scripts/check-fonts.mjs"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@eslint/compat": "2.1.1",
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/forms": "0.5.11",
		"@tailwindcss/typography": "0.5.20",
		"@tailwindcss/vite": "4.3.3",
		"@types/d3-geo": "3.1.1",
		"@types/delaunator": "5.0.3",
		"@types/geojson": "7946.0.16",
		"@types/node": "22.20.5",
		"eslint": "10.13.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.1",
		"fontnik": "0.7.7",
		"globals": "17.13.0",
		"glyph-pbf-composite": "0.0.2",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"sharp": "0.35.5",
		"sirv": "3.0.2",
		"svelte": "5.57.3",
		"svelte-check": "4.7.7",
		"tailwindcss": "4.3.3",
		"topojson-client": "3.1.0",
		"typescript": "6.0.3",
		"vite": "8.3.5",
		"world-atlas": "2.0.2"
	},
	"dependencies": {
		"@lucide/svelte": "1.62.0",
		"@turf/helpers": "7.4.0",
		"bits-ui": "2.20.2",
		"d3-format": "3.1.2",
		"d3-geo": "3.1.1",
		"delaunator": "5.1.0",
		"maplibre-gl": "6.16.0",
		"marked": "18.1.2",
		"opentype.js": "2.0.0",
		"pmtiles": "4.5.0",
		"svelte-maplibre-gl": "2.2.1"
	}
}
