# Self-hosted basemap archive, built by `pnpm basemap:build` and served as a static file.
# There is no API key and no third-party tile service — see www/DEPLOY_TILES.md.
PUBLIC_BASEMAP_URL=https://tiles.bikenetkit.org/basemap-20260902.pmtiles
# Self-hosted intro video (web-encoded MP4). Unset → the landing shows the poster placeholder.
PUBLIC_VIDEO_URL=https://tiles.bikenetkit.org/media/bikenetkit-intro.mp4
# Set to "true" to show the temporary "coming soon" placeholder at /; unset/false shows the full landing.
# This is a *local* preference, not a launch switch. Keep it false: `pnpm deploy:site` builds with
# this value, and `pnpm deploy:placeholder` forces it to true on its own.
PUBLIC_LANDING_PLACEHOLDER=false
# Base URL for the off-repo GeoJSON host (deployed via `pnpm deploy:data`). No API key; own static
# server. To see the bike networks locally without the data on disk, set it to
# https://data.bikenetkit.org (it allows requests from localhost). Leave it EMPTY only if you have
# www/data/ locally (maintainers, after `pnpm pull-data`): the dev server then serves that.
# See www/DEPLOY_DATA.md.
# `pnpm deploy:site` / `deploy:placeholder` ignore this and always force DEPLOY_PUBLIC_DATA_URL
# below: the data no longer lives under static/, so no build ever carries it.
PUBLIC_DATA_URL=

# Deployment / data sync. Auth is key-based SSH (run `ssh-copy-id` once); no password stored.
# DEPLOY_HOST: ssh alias (define in ~/.ssh/config) or user@host, e.g. <SSH_USER>@<SERVER_IP>
DEPLOY_HOST=bikenetkit
# Server dir holding raw exports as <DATA_PATH>/<YYYYMMDD>/<tool>/  (consumed by `pnpm pull-data`)
DEPLOY_DATA_PATH=~/bikenetkit/dataexports/
# Server dir the static build is rsynced into  (target of `pnpm deploy:site`)
DEPLOY_WEB_PATH=~/bikenetkit/website/
# Server dir for the "coming soon" build  (target of `pnpm deploy:placeholder`; optional, defaults to this)
DEPLOY_PLACEHOLDER_WEB_PATH=~/bikenetkit/placeholder-website/
# Server dir for the preview build  (target of `pnpm deploy:preview`, served by <PREVIEW_HOST>; optional, defaults to this)
DEPLOY_PREVIEW_WEB_PATH=~/bikenetkit/preview-website/
# Server dir for the basemap archive  (target of `pnpm deploy:basemap`; optional, defaults to this)
DEPLOY_TILES_PATH=~/bikenetkit/tiles/
# Server dir for self-hosted media  (target of `pnpm deploy:media`; served at tiles.bikenetkit.org/media/)
DEPLOY_MEDIA_PATH=~/bikenetkit/tiles/media/
# Server dir for the off-repo GeoJSON data  (target of `pnpm deploy:data`, served at
# data.bikenetkit.org; optional, defaults to this). Outside the website dir so `deploy:site`
# --delete cannot erase it.
DEPLOY_DATA_WEB_PATH=~/bikenetkit/data/
# PUBLIC_DATA_URL forced into `deploy:site` / `deploy:placeholder` builds (optional, defaults to
# this). Overrides the local-dev empty value above so the deployed build fetches GeoJSON from the
# data subdomain instead of the site origin, where data/ is excluded from the rsync.
DEPLOY_PUBLIC_DATA_URL=https://data.bikenetkit.org

# Working disk for `pnpm basemap:build`. Needs ~60 GB free — the archive is ~46 GB.
# External drive, not a repo path.
BASEMAP_WORK_DIR=/path/to/scratch-disk

# Local paths that default to sibling checkouts of this repo. Set these if your layout differs;
# the scripts say which one they want when the default is missing.
# Where `pnpm pull-data` rsyncs the server export to, and what a bare `pnpm update-data` reads
# (default: ../../05_dev_data_pull).
# DATA_PULL_ROOT=/path/to/dataexports-pull
# Source dir for `pnpm deploy:media` (default: ../../05_dev_data/media). Or pass --src <file>.
# MEDIA_SRC_DIR=/path/to/media

# user:password for <PREVIEW_HOST>, used only by `pnpm check:headers -- --base https://<PREVIEW_HOST>`
# (optional, only while the preview is gated; the password lives on the server, see DEPLOY_NGINX.md § The preview vhost)
PREVIEW_AUTH=
